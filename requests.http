@baseUrl = http://localhost:8080
@token =

### Health check (public)
GET {{baseUrl}}/health

### Register
# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "Password1!"
}

### Login (copy token from response, or use chained variable below)
# @name login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "you@example.com",
  "password": "Password1!"
}

@token = {{login.response.body.token}}

### List ingredients (requires auth)
GET {{baseUrl}}/api/ingredients
Authorization: Bearer {{token}}

### Create chicken breast
# @name createIngredient
POST {{baseUrl}}/api/ingredients
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Chicken Breast, raw",
  "macroBasis": "RAW",
  "proteinPer100g": 22.5,
  "carbsPer100g": 0.0,
  "fatPer100g": 2.6,
  "kcalPer100g": 120.0,
  "notes": "From Cronometer Data"
}

### Get chicken breast (use id from create response)
GET {{baseUrl}}/api/ingredients/1
Authorization: Bearer {{token}}

### Create prep session
# @name createPrepSession
POST {{baseUrl}}/api/prep-sessions
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Sunday chicken prep",
  "sessionDate": "2026-07-20",
  "notes": "Sunday chicken prep"
}

@prepSessionId = {{createPrepSession.response.body.id}}

### Add chicken batch to session (use session id from above)
# @name createBatch
POST {{baseUrl}}/api/prep-sessions/{{prepSessionId}}/batches
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "ingredientId": 1,
  "rawWeightG": 2146,
  "cookedWeightG": 1600
}

@batchId = {{createBatch.response.body.id}}

### Read session back with batches
GET {{baseUrl}}/api/prep-sessions/{{prepSessionId}}
Authorization: Bearer {{token}}

### Portion calculate — 200g cooked chicken (expect cronometerG ≈ 268.25, protein ≈ 60.4)
POST {{baseUrl}}/api/portion/calculate
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "batchId": {{batchId}},
  "cookedGrams": 200
}

### Portion export — Cronometer copy-paste block (text/plain response)
POST {{baseUrl}}/api/portion/export
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "lines": [
    {
      "batchId": {{batchId}},
      "cookedGrams": 200
    }
  ]
}

### Protected route without token (expect 401 or 403)
GET {{baseUrl}}/api/ingredients

### Update batch
PUT {{baseUrl}}/api/prep-sessions/{{prepSessionId}}/batches/{{batchId}}
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "ingredientId": 1,
  "rawWeightG": 2200,
  "cookedWeightG": 1600
}

### Read session to verify batch update
GET {{baseUrl}}/api/prep-sessions/{{prepSessionId}}
Authorization: Bearer {{token}}

### Delete batch
DELETE {{baseUrl}}/api/prep-sessions/{{prepSessionId}}/batches/{{batchId}}
Authorization: Bearer {{token}}

### Read session to verify batch deletion
GET {{baseUrl}}/api/prep-sessions/{{prepSessionId}}
Authorization: Bearer {{token}}
